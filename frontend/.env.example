# ============================================================
#  前端环境变量示例（复制为 .env.local 并填写实际值）
#  所有变量必须以 VITE_ 开头，Vite 才会注入到前端代码
# ============================================================

# ---- 后端 API 地址（开发环境） ----
VITE_API_BASE_URL=http://localhost:8080/api

# ---- Feature Flags（true = 开启该功能模块, false = 关闭/隐藏） ----
VITE_FEATURE_RESUME=true          # 简历上传与解析
VITE_FEATURE_AI_LOCAL=true        # 本地 AI 模式（true = 后端本地模板, false = 需后端配置真实 LLM）
VITE_FEATURE_SPEECH=true          # 语音识别与语音合成（需浏览器支持 Web Speech API）
VITE_FEATURE_POSTURE=true         # 摄像头姿态检测（需浏览器支持摄像头）
VITE_FEATURE_PDF_REPORT=true     # PDF 报告下载

# ---- AI 提供商（仅前端展示用，实际 AI 调用由后端控制） ----
VITE_AI_PROVIDER=local            # local | openai | qwen | deepseek | custom

# ---- 应用标题 ----
VITE_APP_TITLE=AI 模拟面试
